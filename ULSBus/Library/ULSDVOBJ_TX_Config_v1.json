                    "default": [
                        0,
                        0,
                        0
                    ],
                    "min": -100.0,
                    "max": 100.0
                },
                {
                    "name": "magCalScaleEx",
                    "type": "float",
                    "lenght": 3,
                    "description": "External compass calibration scale",
                    "default": [
                        1,
                        1,
                        1
                    ],
                    "min": 0.01,
                    "max": 100.0
