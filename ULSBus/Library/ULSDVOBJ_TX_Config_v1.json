                {
                    "name": "canProtocol",
                    "type": "opt_uint8",
                    "description": "CAN bus device protocol",
                    "default": 0,
                    "opts": [
                        "ULSDECONET",
                        "SimpleCAN"
                    ]
                },
                {
                    "name": "canSpeed",
                    "type": "opt_uint8",
                    "description": "CAN speed",
                    "default": 4,
                    "opts": [
                        "1000000",
                        "500000",
                        "250000",
                        "125000"
                    ]
                },
                {
                    "name": "magCalOffset",
                    "type": "float",
                    "lenght": 3,
                    "description": "Compass calibration offset",
                    "default": [
                        0,
