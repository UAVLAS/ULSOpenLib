{
    "BookVersion": "1.0",
    "Objects": [
        {
            "name": "ULSDVOBJ_RX_Config_v2",
            "description": "Receiver General configuration",
            "access": "config",
            "variables": [
                {
                    "name": "name",
                    "type": "char",
                    "lenght": 16,
                    "default": "ULS-RX",
                    "description": "Name"
                },
                {
                    "name": "ctrl",
                    "type": "flags_uint8",
                    "description": "Transmitter control byte",
                    "default": 1,
                    "flags": [
                        "transmitter_level_compensation",
                        "reserved_noise_debug",
                        "reserved_disable_imu",
                        "reserved_disable_mrx",
                        "disable_dacs_yaw_correction",
                        "disable_indication"
                    ]
                },
                {
                    "name": "sensitivity",
                    "type": "float",
                    "description": "Reserved, not used by the firmware yet. Receiver sensitivity",
                    "default": 1.0,
                    "min": 0.8,
                    "max": 1.2,
                    "level": "reserved"
                },
                {
                    "name": "rxGain",
                    "type": "float",
                    "description": "Analog gain of the receiver front end. Lower it when the emitter is close enough to saturate the input stage, raise it for range. Distance and DACS calibration are corrected for this automatically, so changing it does not re-scale the reported position.",
                    "units": "dB",
                    "default": 40.0,
                    "min": 0.0,
                    "max": 42.0,
                    "level": "advanced"
                },
                {
                    "name": "rxAmplification",
                    "type": "float",
                    "description": "Amplification of the measured signal, for signal lost in front of the receiver (a cover glass or window). The distance is computed from the signal level, so a loss makes it read long: raise this until the reported distance matches the true one. A distance that reads m times the true one needs 40*log10(m) dB (10% long: 1.7 dB). Unlike rxGain it does re-scale the distance, and it adds no range - raise rxGain for range.",
                    "units": "dB",
                    "default": 0.0,
                    "min": -10.0,
                    "max": 20.0,
                    "level": "advanced"
                },
                {
                    "name": "rxOffsetF",
                    "type": "float",
                    "description": "Receiver offset (front)",
                    "units": "m",
                    "default": 0.0,
                    "min": -1.2,
                    "max": 1.2
                },
                {
                    "name": "rxOffsetR",
                    "type": "float",
                    "description": "Receiver offset (right)",
                    "units": "m",
                    "default": 0.0,
                    "min": -1.2,
                    "max": 1.2
                },
                {
                    "name": "rxYaw",
                    "type": "float",
                    "description": "Receiver YAW orientation relative to body",
                    "units": "m",
                    "default": 0.0,
                    "min": -180,
                    "max": 180
                },
                {
                    "name": "txOffsetF",
                    "type": "float",
                    "description": "Reserved, not used by the firmware yet. Transmitter offset (front)",
                    "units": "m",
                    "default": 0.0,
                    "min": -1.2,
                    "max": 1.2,
                    "level": "reserved"
                },
                {
                    "name": "txOffsetR",
                    "type": "float",
                    "description": "Reserved, not used by the firmware yet. Transmitter offset (right)",
                    "units": "m",
                    "default": 0.0,
                    "min": -1.2,
                    "max": 1.2,
                    "level": "reserved"
                },
                {
                    "name": "relPosGain",
                    "type": "float",
                    "description": "Relative position Gain",
                    "units": "K",
                    "default": 1.0,
                    "min": 0.1,
                    "max": 5.0,
                    "level": "advanced"
                },
                {
                    "name": "angScale",
                    "type": "float",
                    "lenght": 2,
                    "description": "Scale of the X and Y deviation angles from the transmitter's centre line (status ang[0], ang[1]). Raise an axis when its reported offset reads short of the true one, lower it when it reads long.",
                    "units": "K",
                    "default": [
                        1.0,
                        1.0
                    ],
                    "min": 0.5,
                    "max": 2.0,
                    "level": "advanced"
                },
                {
                    "name": "relVelGain",
                    "type": "float",
                    "description": "Relative velocity Gain",
                    "units": "K",
                    "default": 1.0,
                    "min": 0.1,
                    "max": 5.0,
                    "level": "advanced"
                },
                {
                    "name": "predictionTime",
                    "type": "float",
                    "description": "Interval to predict positions if no signal",
                    "units": "s",
                    "default": 1.0,
                    "min": 0.0,
                    "max": 5,
                    "level": "advanced"
                },
                {
                    "name": "platformAcc",
                    "type": "float",
                    "description": "Reserved, not used by the firmware yet. Ground platform acceleration",
                    "units": "m/ss",
                    "default": 0.1,
                    "min": 0.01,
                    "max": 5.0,
                    "level": "reserved"
                },
                {
                    "name": "positionFilterAcc",
                    "type": "float",
                    "description": "Position filter acceleration",
                    "units": "m/ss",
                    "default": 0.3,
                    "min": 0.01,
                    "max": 5.0,
                    "level": "advanced"
                },
                {
                    "name": "serial1Protocol",
                    "type": "opt_uint8",
                    "description": "Serial port 1 Protocol",
                    "default": 1,
                    "opts": [
                        "Disabled",
                        "ULSDECONET",
                        "MavlinkV2",
                        "APx",
                        "ASCII"
                    ]
                },
                {
                    "name": "serial1Brt",
                    "type": "opt_uint8",
                    "description": "Serial port 1 speed",
                    "default": 4,
                    "opts": [
                        "19200",
                        "38400",
                        "57600",
                        "115200",
                        "230400",
                        "460800",
                        "921600"
                    ]
                },
                {
                    "name": "serial1Options",
                    "type": "uint8",
                    "description": "Reserved, not used by the firmware yet. Serial port 1 Options",
                    "default": 0,
                    "flags": [
                        "rx_enabled",
                        "tx_enabled",
                        "rx_termination_enabled",
                        "tx_termination_enabled",
                        "rx_inverted",
                        "tx_inverted"
                    ],
                    "level": "reserved"
                },
                {
                    "name": "serial2Protocol",
                    "type": "opt_uint8",
                    "description": "Serial port 2 Protocol",
                    "default": 1,
                    "opts": [
                        "Disabled",
                        "ULSDECONET",
                        "MavlinkV2",
                        "APx",
                        "ASCII"
                    ]
                },
                {
                    "name": "serial2Brt",
                    "type": "opt_uint8",
                    "description": "Serial port 2 speed",
                    "default": 4,
                    "opts": [
                        "19200",
                        "38400",
                        "57600",
                        "115200",
                        "230400",
                        "460800",
                        "921600"
                    ]
                },
                {
                    "name": "serial2Options",
                    "type": "uint8",
                    "description": "Reserved, not used by the firmware yet. Serial port 2 Options",
                    "default": 0,
                    "flags": [
                        "rx_enabled",
                        "tx_enabled",
                        "rx_termination_enabled",
                        "tx_termination_enabled",
                        "rx_inverted",
                        "tx_inverted"
                    ],
                    "level": "reserved"
                },
                {
                    "name": "can1Address",
                    "type": "uint8",
                    "description": "CAN bus 1 static address",
                    "default": 0
                },
                {
                    "name": "can1Protocol",
                    "type": "opt_uint8",
                    "description": "Reserved, not used by the firmware yet. CAN bus 1 protocol",
                    "default": 0,
                    "opts": [
                        "ULSDECONET",
                        "SimpleCAN"
                    ],
                    "level": "reserved"
                },
                {
                    "name": "can1Speed",
                    "type": "opt_uint8",
                    "description": "CAN bus 1 speed",
                    "default": 4,
                    "opts": [
                        "1000000",
                        "500000",
                        "250000",
                        "125000"
                    ]
                },
                {
                    "name": "can1Options",
                    "type": "uint8",
                    "description": "Reserved, not used by the firmware yet. CAN bus 1 Options",
                    "default": 0,
                    "flags": [
                        "termination_enabled"
                    ],
                    "level": "reserved"
                },
                {
                    "name": "can2Address",
                    "type": "uint8",
                    "description": "Reserved, not used by the firmware yet. CAN bus 2 static address",
                    "default": 0,
                    "level": "reserved"
                },
                {
                    "name": "can2Protocol",
                    "type": "opt_uint8",
                    "description": "Reserved, not used by the firmware yet. CAN bus 2 protocol",
                    "default": 0,
                    "opts": [
                        "ULSDECONET",
                        "SimpleCAN"
                    ],
                    "level": "reserved"
                },
                {
                    "name": "can2Speed",
                    "type": "opt_uint8",
                    "description": "Reserved, not used by the firmware yet. CAN bus 2 speed",
                    "default": 4,
                    "opts": [
                        "1000000",
                        "500000",
                        "250000",
                        "125000"
                    ],
                    "level": "reserved"
                },
                {
                    "name": "can2Options",
                    "type": "uint8",
                    "description": "Reserved, not used by the firmware yet. CAN bus 2 Options",
                    "default": 0,
                    "flags": [
                        "termination_enabled"
                    ],
                    "level": "reserved"
                },
                {
                    "name": "mavlinkFrames",
                    "type": "flags_uint8",
                    "description": "Mavlink V2 Frame variants to send",
                    "default": 7,
                    "flags": [
                        "MAV_FRAME_BODY_FRD",
                        "MAV_FRAME_LOCAL_OFFSET_NED",
                        "MAV_FRAME_LOCAL_NED",
                        "VISION_POSITION_ESTIMATE"
                    ]
                },
                {
                    "name": "magCalOffset",
                    "type": "float",
                    "lenght": 3,
                    "description": "Reserved, not used by the firmware yet. Compass calibration offset",
                    "default": [
                        0,
                        0,
                        0
                    ],
                    "min": -30.0,
                    "max": 30.0,
                    "level": "reserved"
                },
                {
                    "name": "magCalScale",
                    "type": "float",
                    "lenght": 3,
                    "description": "Reserved, not used by the firmware yet. Compass calibration scale",
                    "default": [
                        1,
                        1,
                        1
                    ],
                    "min": 0.01,
                    "max": 30.0,
                    "level": "reserved"
                },
                {
                    "name": "magCalOffsetEx",
                    "type": "float",
                    "lenght": 3,
                    "description": "Reserved, not used by the firmware yet. External compass calibration offset",
                    "default": [
                        0,
                        0,
                        0
                    ],
                    "min": -100.0,
                    "max": 100.0,
                    "level": "reserved"
                },
                {
                    "name": "magCalScaleEx",
                    "type": "float",
                    "lenght": 3,
                    "description": "Reserved, not used by the firmware yet. External compass calibration scale",
                    "default": [
                        1,
                        1,
                        1
                    ],
                    "min": 0.01,
                    "max": 100.0,
                    "level": "reserved"
                },
                {
                    "name": "indicatorBrightness",
                    "type": "uint8",
                    "description": "Indicator brightness",
                    "units": "%",
                    "default": "100",
                    "min": 0,
                    "max": 100
                },
                {
                    "name": "configCRC",
                    "type": "uint16",
                    "description": "Reserved, not used by the firmware yet. Configuration checksum",
                    "default": 0,
                    "level": "reserved"
                }
            ]
        }
    ]
}
